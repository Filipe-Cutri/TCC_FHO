# Slotify Backend - Environment Variables Template
# Copy this file to .env and fill in your actual values
# DO NOT commit .env file to version control

# Spring Profile Configuration
SPRING_PROFILES_ACTIVE=dev

# Database Configuration (for local development)
# Railway will auto-provide these values in production
DATABASE_URL=jdbc:postgresql://localhost:5432/slotify
PGUSER=postgres
PGPASSWORD=postgres

# Server Configuration
PORT=8080
SSL_ENABLED=false

# SSL Keystore Configuration (optional)
# SSL_KEYSTORE=classpath:slotfy.p12
# SSL_KEYSTORE_PASSWORD=slotfypass

# SendGrid Email Configuration
# Get your API key from https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=noreply@slotfy.com
SENDGRID_FROM_NAME=Slotfy - Sistema de Agendamento

# File Upload Configuration
FILE_UPLOAD_DIR=/tmp/uploads
MAX_FILE_SIZE=5MB
MAX_REQUEST_SIZE=5MB

# JPA/Hibernate Configuration
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false

# Logging Configuration
LOGGING_HIBERNATE_SQL=DEBUG
LOGGING_HIBERNATE_BINDER=TRACE
