# Environment Variables Template for Slotfy Backend
# 
# INSTRUÇÕES:
# 1. Copie este arquivo para .env (NÃO commite o arquivo .env!)
# 2. Preencha os valores das variáveis com suas credenciais reais
# 3. Certifique-se de que .env está listado no .gitignore
#
# Para Railway, configure estas variáveis no dashboard do Railway

# ==========================================
# DATABASE CONFIGURATION
# ==========================================
# Para Railway, estas variáveis são fornecidas automaticamente
# Para desenvolvimento local, configure conforme necessário
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/slotfy
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=postgres

# ==========================================
# SPRING CONFIGURATION
# ==========================================
SPRING_PROFILES_ACTIVE=prod
# PORT é fornecido automaticamente pelo Railway

# ==========================================
# EMAIL CONFIGURATION (SendGrid)
# ==========================================
# Obtenha sua API key em: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=SG.your-sendgrid-api-key
SENDGRID_FROM=noreply@slotfy.com

# ==========================================
# FRONTEND URL
# ==========================================
# URL do frontend para links de reset de senha, etc.
FRONTEND_URL=https://your-frontend.railway.app

